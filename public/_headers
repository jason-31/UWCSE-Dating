# Response headers for static assets (Workers Static Assets reads this file; it is not served).
# Responses from the Worker (/api/*, /auth/*) set their own headers in src/platform/http.js.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
